[
    {
        "id": "preferences",
        "children": [
            {
                "id": "package-settings",
                "children": [
                    {
                        "caption": "MarkdownReader",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/MarkdownReader/MarkdownReader.sublime-settings",
                                    "default": "{\n    $0\n}\n"
                                }
                            },
                            {
                                "caption": "Show Diagnostics",
                                "command": "markdown_reader_check_renderer_environment"
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
